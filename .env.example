# Reference only: cfctl does not automatically load .env files.
CLOUDFLARE_MCP_URL=https://mcp.cloudflare.com/mcp
CLOUDFLARE_MCP_TIMEOUT_MS=30000
CLOUDFLARE_MCP_TOKEN=replace-with-a-least-privilege-api-token
# Alternative to CLOUDFLARE_MCP_TOKEN; do not set both:
# CLOUDFLARE_MCP_AUTHORIZATION=Bearer replace-with-token
# CLOUDFLARE_MCP_HEADERS_JSON={"CF-Access-Client-Id":"...","CF-Access-Client-Secret":"..."}
